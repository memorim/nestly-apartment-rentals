# Optional local API port; default used by pnpm start.
PORT=4600

# Public server: HTTPS reverse proxy and a random owner secret (at least 32 characters).
# APP_PUBLIC_ORIGIN=https://nestly.example.com
# APP_OWNER_TOKEN=
CONTACT_RETENTION_DAYS=90
# Optional signed webhook for your manager/CRM adapter. No contacts are sent.
# INQUIRY_WEBHOOK_URL=https://your-adapter.example.com/inquiries
# INQUIRY_WEBHOOK_SECRET=

# Free push alternative to the configured webhook; use a random secret topic.
# NTFY_TOPIC=

# Persistent mount point for all application databases.
# NESTLY_DATA_DIRECTORY=/var/lib/nestly
